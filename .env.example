# GEMINI_API_KEY: Required for server-side Gemini AI Insight calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# METASCOPE_MAX_UPLOAD_MB: Max upload size in MB for Mode Mendalam (POST /api/analyze). Default: 100
METASCOPE_MAX_UPLOAD_MB="100"

# METASCOPE_DEEP_MODE_DISABLED: Set to "true" to simulate engine_unavailable fallback to Private mode
METASCOPE_DEEP_MODE_DISABLED="false"

# METASCOPE_MAX_VIDEO_MB: Max upload size in MB for Video Compressor (POST /api/compress). Default: 200
METASCOPE_MAX_VIDEO_MB="200"

